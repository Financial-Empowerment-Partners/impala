<?xml version="1.0" encoding="utf-8"?>
<!-- Testnet (tnet flavor) network security config. The default bridge URL is
     http://10.0.2.2:8080 (emulator loopback alias for the host machine), so
     cleartext is permitted for that single host only — everything else must
     use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
