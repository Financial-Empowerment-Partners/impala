<?xml version="1.0" encoding="utf-8"?>
<!--
    Login. The header draws under the status bar (LoginActivity forces light
    status-bar icons and pads loginHeader for the top inset); scrollLogin is
    padded for the navigation bar and the IME (adjustResize).

    Ids the other lanes rely on: btnCard (CardLoginUiTest), btnCardLab
    (initially gone; LoginActivity decides), tilAccountId / tilPassword
    (field errors), cardError containing tvError, etAccountId, etPassword,
    btnSignIn, btnGoogle, btnGithub, btnOkta, progressIndicator.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
            Brand header: generated dark teal gradient, white text in both modes.
            The progress indicator overlays its bottom edge, so showing it never
            moves the form.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/loginHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_header"
                android:gravity="center"
                android:minHeight="@dimen/login_header_min_height"
                android:orientation="vertical"
                android:paddingTop="@dimen/login_header_padding_top"
                android:paddingBottom="@dimen/login_header_padding_bottom">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_contactless"
                    android:tint="?attr/colorOnBrandHeader" />

                <TextView
                    android:id="@+id/tvWordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:accessibilityHeading="true"
                    android:text="@string/login_header"
                    android:textAppearance="@style/TextAppearance.ImpalaDemo.Wordmark"
                    android:textColor="?attr/colorOnBrandHeader" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/login_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnBrandHeader" />

                <!-- Which Stellar network this build talks to (shown on test networks only). -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLoginNetwork"
                    style="@style/Widget.ImpalaDemo.Chip.Status.Warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_network_testnet"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="14dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorOnBrandHeader"
                app:trackColor="@color/login_progress_track" />
        </FrameLayout>

        <!-- Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/login_padding"
            android:paddingTop="@dimen/login_form_padding_top"
            android:paddingEnd="@dimen/login_padding"
            android:paddingBottom="@dimen/login_form_padding_bottom">

            <!--
                Error card: collapses to nothing while tvError is gone (no
                padding or stroke of its own), so toggling either view works.
                The live region announces new error text politely.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardError"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                app:cardBackgroundColor="?attr/colorErrorContainer"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:drawableTint="?attr/colorOnErrorContainer"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnErrorContainer"
                    android:drawableStart="@drawable/ic_error"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAccountId"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/hint_account_id"
                app:startIconContentDescription="@null"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAccountId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:importantForAutofill="yes"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_password"
                app:endIconMode="password_toggle"
                app:startIconContentDescription="@null"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:importantForAutofill="yes"
                    android:imeOptions="actionGo"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/btn_sign_in" />

            <!-- Divider with OR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/divider_or"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- NFC card sign-in (visibility rule lives in LoginActivity). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCard"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:text="@string/btn_card"
                app:icon="@drawable/ic_contactless"
                app:iconGravity="textStart"
                app:iconPadding="12dp" />

            <!-- Brand marks: Google untinted in its own colours, GitHub in onSurface. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.ImpalaDemo.Button.OAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/btn_google"
                app:icon="@drawable/ic_google" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGithub"
                style="@style/Widget.ImpalaDemo.Button.OAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/btn_github"
                app:icon="@drawable/ic_github"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOkta"
                style="@style/Widget.ImpalaDemo.Button.OAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/btn_okta" />

            <!-- Quiet entry to the read-only Card Lab (gone until LoginActivity shows it). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCardLab"
                style="@style/Widget.ImpalaDemo.Button.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:minHeight="@dimen/touch_target"
                android:text="@string/login_card_lab"
                android:visibility="gone"
                app:icon="@drawable/ic_lab" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
