<?xml version="1.0" encoding="utf-8"?>
<!--
    Cards tab. Ids kept: emptyState, recyclerView, fabRegisterCard. The list
    keeps clear of the FAB (bottom padding) and draws under it while scrolling.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Empty state: a dashed card silhouette with the contactless glyph. -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/card_silhouette_width"
            android:layout_height="@dimen/card_silhouette_height"
            android:background="@drawable/bg_card_silhouette"
            android:importantForAccessibility="no">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_contactless"
                android:tint="?attr/colorOutline" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/empty_cards"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/cards_empty_hint"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/card_margin"
        android:paddingTop="@dimen/card_margin"
        android:paddingEnd="@dimen/card_margin"
        android:paddingBottom="@dimen/list_bottom_clearance" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabRegisterCard"
        style="@style/Widget.ImpalaDemo.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/cards_add"
        app:srcCompat="@drawable/ic_add" />

</FrameLayout>
