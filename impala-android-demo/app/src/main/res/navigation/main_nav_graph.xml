<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/nav_cards">

    <fragment
        android:id="@+id/nav_cards"
        android:name="com.payala.impala.demo.ui.fragments.CardsFragment"
        android:label="@string/nav_cards" />

    <fragment
        android:id="@+id/nav_transfers"
        android:name="com.payala.impala.demo.ui.fragments.TransfersFragment"
        android:label="@string/nav_transfers" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.payala.impala.demo.ui.fragments.SettingsFragment"
        android:label="@string/nav_settings">
        <!-- Shared-axis X in both directions, so back (and predictive back) animates too. -->
        <action
            android:id="@+id/action_settings_to_notifications"
            app:destination="@id/nav_notification_preferences"
            app:enterAnim="@anim/shared_axis_x_in"
            app:exitAnim="@anim/shared_axis_x_out"
            app:popEnterAnim="@anim/shared_axis_x_pop_in"
            app:popExitAnim="@anim/shared_axis_x_pop_out" />
    </fragment>

    <fragment
        android:id="@+id/nav_notification_preferences"
        android:name="com.payala.impala.demo.ui.fragments.NotificationPreferencesFragment"
        android:label="@string/nav_notifications" />

</navigation>
