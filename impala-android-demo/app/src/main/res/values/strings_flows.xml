<?xml version="1.0" encoding="utf-8"?>
<!--
    Lane L3 strings: the tap sheet, the Cards face and the Transfers rows.
    Never redefine a name from strings.xml or strings_foundation.xml (aapt2
    rejects duplicates). Card copy says "card", never transport class names.
-->
