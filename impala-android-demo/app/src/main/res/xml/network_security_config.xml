<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback network security config (main source set).

     Every built flavor overrides this file from its own source set —
       app/src/tnet/res/xml/network_security_config.xml (cleartext to the
         emulator host alias 10.0.2.2 only)
       app/src/live/res/xml/network_security_config.xml (HTTPS only, with a
         commented-out certificate-pinning template)
     — so this copy is never packaged today. It exists so that a flavor added
     WITHOUT its own override inherits an HTTPS-only, pin-free baseline,
     never a cleartext exception and never placeholder pins (an active
     pin-set with placeholder digests breaks every TLS connection).

     Certificate pins are added per flavor, never here: see README.md,
     "Certificate pinning", for the procedure (leaf pin plus a backup pin,
     real host, expiration) and the rotation discipline. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
