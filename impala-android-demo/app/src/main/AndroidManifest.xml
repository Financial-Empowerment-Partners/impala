<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- ImpalaPushService posts FCM notifications (API 33+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- impala-lib declares location permissions for its geolocation feature,
         which the demo does not use. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".ImpalaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImpalaDemo"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The flavour's applet AID for impala-lib's NfcContactActivity (system
             dispatch outside reader mode). android:resource, not android:value:
             AAPT2 would type a 20-digit hex value as a float. The string comes
             from a per-flavour resValue (app/build.gradle.kts); "" means no
             SELECT (the card's default-selected applet answers). -->
        <meta-data
            android:name="com.payala.impala.CARD_APPLET_AID"
            android:resource="@string/impala_card_applet_aid" />

        <!-- Every activity declares android:exported explicitly; only the
             launcher and the two OAuth redirect targets are exported
             (ManifestTest pins this). -->

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ImpalaDemo.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ImpalaDemo.NoActionBar" />

        <activity
            android:name=".ui.log.LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.ImpalaDemo.NoActionBar" />

        <activity
            android:name=".ui.nfc.NfcDebugActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ImpalaDemo.NoActionBar" />

        <!-- Card taps outside reader mode are handled by impala-lib's
             NfcContactActivity (merged from the library manifest), which only
             reads the card identity and forwards it to the CardTapListener
             registered in ImpalaApp. Card flows run in reader mode only. -->

        <!-- Firebase Cloud Messaging service for push notifications -->
        <service
            android:name=".push.ImpalaPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".auth.GitHubRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ImpalaDemo.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="impala"
                    android:host="github-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.OktaRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ImpalaDemo.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="impala"
                    android:host="okta-callback" />
            </intent-filter>
        </activity>

    </application>

</manifest>
