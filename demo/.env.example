# demo/ configuration. scripts/prepare.sh copies this to .env and fills the secrets (0600, gitignored).
# Every value is read by compose.yaml (variable substitution) and by scripts/lib.sh.
# Variables already set in the process environment win over this file (CONTAINER_ENGINE=podman scripts/up.sh works).

# ---------------------------------------------------------------- engine
# Container engine: docker | podman | (empty = auto-detect: docker if its daemon answers, else podman)
CONTAINER_ENGINE=
# podman only. Empty = podman's own search order (docker-compose on PATH, Docker cli-plugins dirs, then
# podman-compose). Set docker-compose, podman-compose or an absolute path to force one.
PODMAN_COMPOSE_PROVIDER=

# ---------------------------------------------------------------- host ports (bound to 127.0.0.1 only)
# 3000 is assumed by the UI's CSP/SSO settings; keep it unless you know why.
UI_PORT=3000
BRIDGE_PORT=8080
# 8200 is pinned by the UI's CSP (connect-src http://localhost:8200 in impala-ui/nginx.conf) and the OIDC issuer; keep it.
OPENBAO_PORT=8200
SIM_PORT=9443
# the Payala stub (payala-stub/: an in-repo stand-in; the proprietary Payala API is not part of the demo)
PAYALA_PORT=4000

# ---------------------------------------------------------------- secrets (generated by prepare.sh; LOCAL DEMO ONLY)
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BAO_DEV_ROOT_TOKEN_ID=dev-root-token
IMPALA_ADMIN_PASSWORD=
IMPALA_AGENT_PASSWORD=
IMPALA_BENEFICIARY_PASSWORD=
IMPALA_HOLDER_PASSWORD=
# card issuance: per-card SCP03 key master key (32 hex) and the PINs the issuance tool provisions
IMPALA_ISSUE_KMK=
IMPALA_USER_PIN=2468
IMPALA_MASTER_PIN=14117298

# ---------------------------------------------------------------- accounts (fixed ids)
# The bridge login username is the Payala user id (impala_account.payala_account_id). The same ids are
# the users seeded into the Payala stub (scripts/prepare.sh renders build/payala-stub/seed.json from them).
PAYALA_MINT_ID=10000000-0000-4000-8000-000000000001
PAYALA_ADMIN_ID=10000000-0000-4000-8000-000000000002
PAYALA_AGENT_ID=10000000-0000-4000-8000-000000000003
PAYALA_BENEFICIARY_ID=10000000-0000-4000-8000-000000000004
PAYALA_SYNC_ID=10000000-0000-4000-8000-000000000005
DEMO_HOLDER_ID=10000000-0000-4000-8000-000000000006

# ---------------------------------------------------------------- demo constants
DEMO_PAYMENT_XLM=25
DEMO_WALLET_SEND_XLM=5
DEMO_OPERATOR_SEND_XLM=3
DEMO_CENTS_PER_XLM=100
DEMO_AGENT_FUNDING_CENTS=50000
DEMO_PAYALA_TRANSFER_CENTS=1234

# ---------------------------------------------------------------- host lanes
# Android emulator lane: auto = run when scripts/doctor.sh finds an emulator + system image; 1 = required; 0 = skip
DEMO_ANDROID=auto
# 1 = headless emulator (-no-window); 0 = show the emulator window (live demos)
DEMO_HEADLESS=1
DEMO_AVD=impala-demo-34
DEMO_SYSTEM_IMAGE=system-images;android-34;google_apis;arm64-v8a
# 1 = let scripts/emulator.sh install the system image / cmdline-tools with sdkmanager when missing (downloads from Google)
DEMO_INSTALL_SDK=0
# Android SDK root that holds emulator/ and system-images/ (empty = $ANDROID_SDK_ROOT, $ANDROID_HOME, ~/Library/Android/sdk)
DEMO_ANDROID_SDK_ROOT=
# JDK 17 home used to LAUNCH Gradle for impala-card and impala-android-demo (empty = /usr/libexec/java_home -v 17)
JAVA17_HOME=
# scardutil checkout for the optional fleet check in scenario 05 (empty = skip)
SCARDUTIL_DIR=
