# =============================================================================
# impala-bridge configuration (.env.example)
#
# Copy to `.env` and fill in. Environment variables take precedence over any
# values in the JSON config file (CONFIG_FILE, default `config.json`).
# Defaults shown in [brackets]. Only the REQUIRED block is needed to boot in
# server mode; everything else enables an optional integration.
# Source of truth: src/config.rs, src/main.rs, src/vault.rs, src/constants.rs.
# =============================================================================

# ---- Required (server mode) -------------------------------------------------
# PostgreSQL connection string. Required unless DATABASE_URL_WRAPPED is set.
DATABASE_URL=postgresql://postgres:password@localhost:5432/impala
# Redis connection string. [redis://127.0.0.1/]
REDIS_URL=redis://localhost:6379
# JWT signing secret. REQUIRED. Must be >= 32 chars or the process exits at startup.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Process mode: server (HTTP API + background tasks) | worker (SQS consumer) |
# migrate (apply ./migrations). [server]
RUN_MODE=server

# ---- Vault (optional alternative to DATABASE_URL) ---------------------------
# If set, the bridge unwraps this single-use Vault cubbyhole token to obtain the
# real DATABASE_URL. Requires VAULT_ADDR. (Either DATABASE_URL or
# DATABASE_URL_WRAPPED must be set.)
# DATABASE_URL_WRAPPED=
# VAULT_ADDR=https://vault.internal:8200

# ---- HTTP server ------------------------------------------------------------
# PUBLIC_ENDPOINT=http://localhost:8080      # advertised base URL
# SERVICE_ADDRESS=0.0.0.0:8080               # bind address
# LOG_FILE=impala-bridge.log
# DEBUG_MODE=false
# CONFIG_FILE=config.json                    # optional JSON config file path
# DB_MAX_CONNECTIONS=20
# HTTP_CLIENT_TIMEOUT_SECS=30
# CORS_ALLOWED_ORIGINS=*                      # '*' warns at startup in production

# ---- Stellar ----------------------------------------------------------------
# STELLAR_NETWORK selects defaults for the URLs/passphrase below. [testnet]
# STELLAR_NETWORK=testnet                     # testnet | pubnet
# STELLAR_HORIZON_URL=                        # default derived from STELLAR_NETWORK
# STELLAR_RPC_URL=
# STELLAR_NETWORK_PASSPHRASE=
# SOROBAN_CONTRACT_ID=

# ---- Okta SSO (optional) ----------------------------------------------------
# OKTA_ISSUER_URL=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_JWKS_REFRESH_SECS=3600

# ---- Twilio (SMS MFA, optional) ---------------------------------------------
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMBER=+15555550100

# ---- LDAP directory sync (optional) -----------------------------------------
# LDAP_URL=ldaps://ldap.internal:636
# LDAP_BIND_DN=cn=svc,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_SEARCH_FILTER=(objectClass=person)

# ---- SNS/SQS job pipeline (worker mode / notification dispatch) --------------
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:impala-jobs
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/impala-worker
# WORKER_CONCURRENCY=10
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT=300

# ---- AWS SES (email notifications, optional) --------------------------------
# SES_FROM_ADDRESS=no-reply@impala.example.com

# ---- Firebase Cloud Messaging (push notifications, optional) -----------------
# FCM_PROJECT_ID=impala-demo
# FCM_SERVICE_ACCOUNT_KEY=/run/secrets/fcm-service-account.json

# ---- OpenTelemetry (optional; logs go to syslog when unset) ------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=impala-bridge
# OTEL_ENVIRONMENT=staging

# ---- Admin role & webhook event feed ----------------------------------------
# Comma-separated account IDs (JWT sub) granted admin. Source of the is_admin
# claim (stamped server-side at token issuance) and the gate for /admin/*,
# /sync, /subscribe. Empty = no admins.
# ADMIN_ACCOUNT_IDS=ops@impala.example.com,admin2@impala.example.com
# ADMIN_WEBHOOK_MAX_ATTEMPTS=6            # delivery attempts before 'failed'
# ADMIN_WEBHOOK_DISABLE_THRESHOLD=10      # consecutive failures -> auto-disable
# ADMIN_WEBHOOK_POLL_SECS=5               # delivery worker poll interval
