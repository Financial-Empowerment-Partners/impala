# =============================================================================
# impala-bridge configuration (.env.example)
#
# Copy to `.env` and fill in. The binary loads `./.env` from its working
# directory at startup (development convenience; it never overrides variables
# already set in the process environment, and the runtime image carries no
# `.env`). Environment variables take precedence over any values in the JSON
# config file (CONFIG_FILE, default `config.json`).
# NOTE: `docker compose up` does NOT forward this file wholesale — the bridge
# container sees only the explicit `environment:` map in docker-compose.yml,
# so anything you need there (RESERVE_*, KEY_IMPORT_ENABLED, ADMIN_ACCOUNT_IDS,
# CORS_ALLOWED_ORIGINS, …) must be added to that map or passed through.
# Defaults shown in [brackets]. Only the REQUIRED block is needed to boot in
# server mode; everything else enables an optional integration.
# Source of truth: src/config.rs, src/main.rs, src/vault.rs, src/constants.rs.
# =============================================================================

# ---- Required (server mode) -------------------------------------------------
# PostgreSQL connection string. Required unless DATABASE_URL_WRAPPED is set.
DATABASE_URL=postgresql://postgres:password@localhost:5432/impala
# Redis connection string. [redis://127.0.0.1/]
# The docker-compose redis requires AUTH (dev default password: "password").
# TLS is supported via the rediss:// scheme (redis crate `tokio-rustls-comp`
# feature) — required when ElastiCache in-transit encryption is enabled, e.g.:
#   REDIS_URL=rediss://:<auth-token>@<elasticache-endpoint>:6379
REDIS_URL=redis://:password@localhost:6379
# JWT signing secret. REQUIRED. Must be >= 32 chars or the process exits at startup.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Verify-only previous secret for zero-downtime rotation: set to the OLD secret
# while tokens signed with it age out (<= 14 days), then unset. Must be >= 32
# chars and differ from JWT_SECRET (enforced at startup).
# JWT_SECRET_PREVIOUS=

# Process mode: server (HTTP API + background tasks) | worker (SQS consumer) |
# migrate (apply ./migrations). [server]
RUN_MODE=server

# ---- Vault (optional alternative to DATABASE_URL) ---------------------------
# If set, the bridge unwraps this single-use Vault cubbyhole token to obtain the
# real DATABASE_URL. Requires VAULT_ADDR. (Either DATABASE_URL or
# DATABASE_URL_WRAPPED must be set.)
# DATABASE_URL_WRAPPED=
# VAULT_ADDR=https://vault.internal:8200

# ---- HTTP server ------------------------------------------------------------
# PUBLIC_ENDPOINT=http://localhost:8080      # advertised base URL
# SERVICE_ADDRESS=0.0.0.0:8080               # bind address
# LOG_FILE is parsed but NOT implemented: logs go to syslog, or to the OTLP
# collector when OTEL_EXPORTER_OTLP_ENDPOINT is set. Setting it does nothing.
# LOG_FILE=impala-bridge.log
# DEBUG_MODE=false
# CONFIG_FILE=config.json                    # optional JSON config file path
# DB_MAX_CONNECTIONS=20
# DB_ACQUIRE_TIMEOUT_SECS=5
# REDIS_POOL_SIZE=16
# HTTP_CLIENT_TIMEOUT_SECS=30
# REQUEST_TIMEOUT_SECS=30                     # global request deadline (408 on expiry)
# CORS_ALLOWED_ORIGINS=*                      # '*' is rejected at startup on pubnet, allowed on testnet
# Browser cookie sessions: Secure + __Host- prefix on by default. Set false ONLY
# for plain-HTTP local development (docker compose does this for you).
# SESSION_COOKIE_SECURE=true
# Number of trusted reverse proxies in front of the bridge. Pre-auth throttling
# (the per-source rate limit and the per-(identity, source) lockouts) attributes
# each request to the X-Forwarded-For entry this many hops from the RIGHT — the
# address the outermost trusted proxy appended — and ignores the sender-written
# leftmost entry and X-Real-Ip. [1] = the ALB. Set 0 whenever the bridge is
# reached directly (local docker-compose sets this for you; a bare host port;
# anything without a proxy that appends the peer): with the header honoured, a
# direct client could write X-Forwarded-For itself and pick its own bucket.
# Two proxies that each append (e.g. CDN -> ALB) would be 2.
# TRUSTED_PROXY_HOPS=1

# Whether POST /authenticate may set a password on an account that exists but has
# no credentials yet (first-touch self-registration). OFF by default, because the
# endpoint is unauthenticated: with it on, anyone who knows an account id can claim
# any credential-less account — including custodial accounts created by
# /managed-account/generate (whose tokens can then sign payments) and accounts that
# only ever log in via SSO or card, which never set a local password and so stay
# claimable indefinitely. Enable only where registration is intentionally public.
# ALLOW_OPEN_REGISTRATION=false

# ---- Stellar ----------------------------------------------------------------
# STELLAR_NETWORK selects defaults for the URLs/passphrase below. [testnet]
# At startup (server and worker modes) the bridge fetches `GET {HORIZON}/` and
# REFUSES TO START if the passphrase Horizon serves differs from the one
# configured here, or if Horizon stays unreachable after a few retries — a
# pubnet Horizon with the testnet default would otherwise sign every
# transaction for the wrong network (tx_bad_auth on every submit).
# STELLAR_NETWORK=testnet                     # testnet | pubnet
# STELLAR_HORIZON_URL=                        # default derived from STELLAR_NETWORK
# STELLAR_RPC_URL=
# STELLAR_NETWORK_PASSPHRASE=
# SOROBAN_CONTRACT_ID=

# ---- Okta SSO (optional, legacy single-provider) ----------------------------
# Setting OKTA_ISSUER_URL alone also synthesizes an `okta` entry in the
# multi-provider registry below.
# OKTA_ISSUER_URL=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_JWKS_REFRESH_SECS=3600

# ---- OIDC SSO (multi-provider registry, optional) ----------------------------
# Declare providers, then configure each with {NAME}_-prefixed vars. Endpoints:
# POST /auth/sso/:provider, GET /auth/sso/:provider/config, GET /auth/providers.
# Public PKCE clients only — no client secret.
# SSO_PROVIDERS=okta,auth0,duo
# {NAME}_ISSUER_URL=            # required; must match the token `iss` exactly
# {NAME}_CLIENT_ID=
# {NAME}_AUDIENCE=              # validated as `aud`; defaults to the client_id
#                               # (set to the API identifier for Auth0)
# {NAME}_JWKS_REFRESH_SECS=3600
# {NAME}_TOKEN_KIND=access      # `id` for providers whose access tokens are
#                               # opaque / carry no identity (Duo SSO, OpenBao)
# {NAME}_INTERNAL_ISSUER_URL=   # optional; server-side base for discovery/JWKS
#                               # fetches when the public issuer is only
#                               # reachable by browsers (split-horizon dev)
# {NAME}_ALLOW_HTTP=false       # dev-only opt-in for plain-HTTP issuers
#
# Local dev: `docker compose up` bootstraps OpenBao as a ready-made `openbao`
# test IdP (login testuser / testpassword) and hands its generated client_id to
# the bridge via CONFIG_FILE=/bootstrap/sso-config.json — no vars needed here.
# See docs/runbooks/test-sso-openbao-local.md.

# ---- Google sign-in (optional) -----------------------------------------------
# Enables POST /auth/google (ID-token exchange). The value must match the
# `aud` claim of the ID tokens your clients obtain (the OAuth web client ID).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_JWKS_REFRESH_SECS=3600

# ---- GitHub sign-in (optional) ------------------------------------------------
# Enables POST /auth/github (access-token exchange via GET /user).
# GITHUB_AUTH_ENABLED=true
# GITHUB_API_URL=https://api.github.com           # override for GitHub Enterprise
# OAuth app credentials for the server-side code->token exchange
# (POST /auth/github {code, redirect_uri}); the secret never ships in clients.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token

# ---- Exchange provider credentials -------------------------------------------
# The three blocks below are the DEFAULT source for provider secrets. With
# KEY_IMPORT_ENABLED=true (see the seed-protection section) an admin may instead
# import them through /admin/keys/{kind}, in which case a stored credential wins
# and these variables become a fallback that reappears the moment the flag goes
# off. GET /admin/keys reports any variable a stored credential is shadowing.

# ---- OwlPay Harbor (fiat<->USDC on/off-ramp, optional) ------------------------
# Enables the OwlPay side of /exchange/* and POST /webhooks/owlpay. The API key
# is created in the Harbor Portal (sandbox self-serve; production issued by
# OwlPay). Secrets are read straight from the environment at startup and never
# enter the Debug-logged Config struct.
# OWLPAY_API_URL=https://harbor-sandbox.owlpay.com   # production URL issued by OwlPay
# OWLPAY_API_KEY=
# OWLPAY_WEBHOOK_SECRET=whs_...     # signing secret from POST /api/v1/notifications/subscriptions

# ---- Changelly crypto swaps (XLM & co -> USDC, optional) ----------------------
# Enables the Changelly swap side of /exchange/* (JSON-RPC v2; no webhooks —
# order status is polled by the reconcile loop). You generate the RSA keypair
# yourself and register the public key with Changelly; the private key is the
# hex-encoded PKCS#8 DER produced by their key-generation instructions.
# CHANGELLY_API_URL=https://api.changelly.com/v2
# CHANGELLY_API_KEY=                # base64(SHA-256(public key)) issued at registration
# CHANGELLY_PRIVATE_KEY=            # hex-encoded PKCS#8 DER private key, or:
# CHANGELLY_PRIVATE_KEY_FILE=/run/secrets/changelly-private-key.hex

# ---- Changelly Fiat API (fiat<->USDC on/off-ramp, optional) -------------------
# Enables the Changelly fiat side of /exchange/* and POST /webhooks/changelly.
# Keys (public + private) are issued by Changelly (psp@changelly.com); sandbox
# and production share the base URL — behaviour follows the key type. The
# callback public key (distinct from your API keypair) verifies webhook
# signatures.
# CHANGELLY_FIAT_API_URL=https://fiat-api.changelly.com/v1
# CHANGELLY_FIAT_API_KEY=
# CHANGELLY_FIAT_PRIVATE_KEY=       # PEM (PKCS#1 or PKCS#8), or:
# CHANGELLY_FIAT_PRIVATE_KEY_FILE=/run/secrets/changelly-fiat-private-key.pem
# CHANGELLY_FIAT_CALLBACK_PUBLIC_KEY=   # PEM "PUBLIC KEY" or base64 DER

# ---- Exchange order reconciliation --------------------------------------------
# Tick interval for the reconcile loop AND the base of each order's
# exponential re-poll backoff. Clamped to >= 1s. Changelly swaps have no
# webhooks, so this is their only status source; webhook-backed providers poll
# at a multiple of it as a safety net.
# EXCHANGE_POLL_SECS=60

# ---- Conversion reserve (bridge service reserve for small orders) -------------
# Fulfills exchange orders under a per-provider threshold ($20-$200, set at
# runtime via PUT /admin/exchange-reserve/policies/{provider}) from a
# bridge-owned pool instead of routing them to Changelly/OwlPay. To enable:
# create a custodial account (POST /managed-account/generate), fund it with
# XLM + USDC (and record matching topup entries via the admin API), then set:
# RESERVE_ACCOUNT_ID=            # payala_account_id of that managed account.
#                                # The account is then quarantined from the
#                                # user-facing /managed-account/* endpoints.
# Per-operation fee BID in stroops for every bridge-signed transaction
# (payouts, refunds, replenishment, trustlines). A Stellar fee is a maximum:
# the ledger charges its effective fee, so this costs 100 stroops in a quiet
# ledger and buys inclusion through surge pricing, where a fixed 100-stroop
# bid failed every submission with tx_insufficient_fee for hours (freezing
# payouts and failing refunds). Clamped to [100, 1000000]. [10000]
# STELLAR_MAX_FEE_STROOPS=10000
# RESERVE_USDC_ISSUER=           # Stellar issuer (G...) of the USDC asset the
#                                # pool pays out; REQUIRED when enabled.
# RESERVE_USDC_CODE=USDC         # asset code of that asset. [USDC]
# Optional second stablecoin: Tether's USDT0, native on Stellar since
# 2026-09-02 (LayerZero OFT). Unset = the USDT0 bucket exists but is inert.
# The issuer is the whole trust anchor — verify it yourself on
# https://docs.usdt0.to (Contract Deployments) and stellar.expert before
# setting it; the bridge validates the strkey checksum and refuses to start
# on a typo. Pubnet at launch: GATISXX6BZ6NC7IKQBY37CJD4SOZL3CYZJWXEDG6JVIY4WBS6KXJHN6Q
# (no testnet deployment is published). After setting it, add the reserve's
# trustline with POST /admin/exchange-reserve/trustlines {"currency":"USDT0"}.
# RESERVE_USDT0_ISSUER=
# RESERVE_USDT0_CODE=USDT0       # asset code (credit_alphanum12). [USDT0]
# Exchange-provider tickers (comma-separated, case-insensitive) that mean
# "USDT0 on Stellar" for auto-swap to_currency / disburse from_currency.
# EMPTY by default: provider ticker strings are provider-specific and must
# be copied from the provider's own currency list, never guessed. With no
# tickers, USDT0 deposits/refunds/balances/admin sends all work, but no
# provider order diverts to the USDT0 leg. May not collide with xlm/usdc.
# RESERVE_USDT0_TICKERS=
# Deposit window for reserve orders (seconds) — ALSO the price-validity window
# (the order-time quote is honored for the whole window, so keep it short).
# Clamped to [300, 7200]. [1800]
# RESERVE_DEPOSIT_TTL_SECS=1800
# Deposit-watcher cadence in seconds (Horizon payment scan + payouts + expiry;
# min 5). [30]
# RESERVE_WATCH_SECS=30
# Price-lock window for reserved quotes (seconds), clamped to [60, 900].
# Kept short deliberately: a lock reserves pool capacity while delivering
# nothing to the customer, so it is pure optionality against the pool. The
# bridge REFUSES TO START if this plus RESERVE_DEPOSIT_TTL_SECS exceeds
# 7200 — the ceiling on total price-option exposure. [300]
# RESERVE_QUOTE_TTL_SECS=300
#
# Automated refunds and replenishment are configured at RUNTIME, not here:
#   PUT /admin/exchange-reserve/settings          (refund master switch)
#   PUT /admin/exchange-reserve/buckets/{cur}     (per-refund + daily caps)
#   PUT /admin/exchange-reserve/replenishment/policies/{kind}
# All default to off / 0, and 0 means "unconfigured, refuse to run" rather
# than "unlimited". See docs/runbooks/conversion-reserve.md.
#
# Webhook callback URLs to register with the providers (out of band: OwlPay via
# POST /api/v1/notifications/subscriptions with events transfer.*, Changelly
# Fiat via your account manager):
#   https://<host>/webhooks/owlpay
#   https://<host>/webhooks/changelly

# ---- Twilio (SMS MFA, optional) ---------------------------------------------
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMBER=+15555550100

# ---- LDAP directory sync (optional) -----------------------------------------
# LDAP_URL=ldaps://ldap.internal:636
# LDAP_BIND_DN=cn=svc,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=ou=people,dc=example,dc=com
# LDAP_SEARCH_FILTER=(objectClass=person)

# ---- SNS/SQS job pipeline (worker mode / notification dispatch) --------------
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:impala-jobs
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/impala-worker
# WORKER_CONCURRENCY=10
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT=300

# ---- AWS SES (email notifications, optional) --------------------------------
# SES_FROM_ADDRESS=no-reply@impala.example.com

# ---- Firebase Cloud Messaging (push notifications, optional) -----------------
# Both are required for mobile_push delivery. FCM_SERVICE_ACCOUNT_KEY is the
# PATH to the Firebase service-account JSON (client_email / private_key /
# token_uri); the worker reads it once at startup, mints RS256 assertion JWTs
# and exchanges them for OAuth2 access tokens (cached ~55 min) to authorize
# FCM HTTP v1 sends. A missing or unreadable file is logged once at startup and
# every push job then fails permanently with a clear reason instead of
# retrying into the DLQ. The key material never appears in logs or events.
# FCM_PROJECT_ID=impala-demo
# FCM_SERVICE_ACCOUNT_KEY=/run/secrets/fcm-service-account.json

# ---- OpenTelemetry (optional; logs go to syslog when unset) ------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_SERVICE_NAME=impala-bridge
# OTEL_ENVIRONMENT=staging

# ---- Admin role & webhook event feed ----------------------------------------
# Comma-separated account IDs (JWT sub) granted admin: overrides the account's
# DB role to `admin` in the JWT role claim (stamped server-side at token
# issuance) and gates /admin/*, /sync, /subscribe. Empty = no allowlist admins
# (DB roles still apply).
# ADMIN_ACCOUNT_IDS=ops@impala.example.com,admin2@impala.example.com
# ADMIN_WEBHOOK_MAX_ATTEMPTS=6            # delivery attempts before 'failed'
# ADMIN_WEBHOOK_DISABLE_THRESHOLD=10      # consecutive failures -> auto-disable
# ADMIN_WEBHOOK_POLL_SECS=5               # delivery worker poll interval

# ---- Custodial seed protection: Vault / OpenBao / KMS (optional) --------------
# OpenBao is an API-compatible HashiCorp Vault fork. BAO_* names take precedence
# over the VAULT_* fallbacks. `docker compose up` runs a local OpenBao dev server
# (http://openbao:8200) and wires these automatically.
#
# Custodial-seed protection via the Transit engine:
# SEED_PROTECTION_BACKEND=openbao   # none (default) | kms | vault | openbao
# BAO_ADDR=http://127.0.0.1:8200
# BAO_TOKEN=dev-root-token          # static token; or BAO_ROLE_ID/BAO_SECRET_ID (AppRole)
# BAO_TRANSIT_KEY=impala-seeds
# AWS KMS backend instead of Transit:
# KMS_SEED_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000
#
# ---- Admin key import (optional, OFF by default) ----------------------------
# Lets an admin install provider credentials and custodial Stellar seeds through
# `/admin/keys/*` and `/admin/stellar-seeds/*` instead of only through this file.
#
# DANGER: a provider credential is SPEND AUTHORITY — the replenishment driver
# sends real reserve XLM to the pay-in address the active Changelly account
# names — and a custodial seed is SIGNING authority. Everything the endpoints
# ask for (echoing the current fingerprint, typing a confirmation phrase) stops
# operator ACCIDENTS; none of it stops a compromised admin token. Read
# docs/runbooks/import-keys.md before turning this on.
#
# With this off (the default) the endpoints refuse AND stored credentials are
# ignored at startup, so behaviour is exactly as it was before the feature
# existed. That also makes it the break-glass switch: turn it off and restart to
# fall back to the environment variables below — which is why a rotation is not
# finished until the old variable is removed from the deployment.
#
# Requires SEED_PROTECTION_BACKEND to be kms/vault/openbao; there is no
# plaintext-at-rest path. Imports take effect at the next ROLLING RESTART, never
# immediately: resolution happens once per process, so all instances switch
# together instead of drifting apart.
# KEY_IMPORT_ENABLED=false
#
# Rotation is a three-step operation, and the third step is the one that gets
# missed: import, roll the deployment, THEN remove the variable below that the
# stored credential now shadows. GET /admin/keys reports any that are still set.
#
# Database URL unwrapping (alternative to DATABASE_URL):
# DATABASE_URL_WRAPPED=s.bad1234567890abc   # one-time wrapping token
